# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# Charts and CSVs written by run_backtest.py (--outdir, default 'output')
output/

# OS noise
.DS_Store

# NOTE: data/*.csv is deliberately TRACKED -- the cached price history is what
# makes `run_backtest.py --offline` work without a data feed.

# Live runner state and the SQLite run log (host-local, never committed)
var/
*.db
*.db-wal
*.db-shm

# Docker deployment secrets (IB login, VNC password)
deploy/docker/.env

# Hourly OHLCV cache (one CSV per name, large)
data/hourly/

# Per-ticker daily OHLC cache for the dashboard candlesticks
data/ohlc/

# Broad US universe pulled from Finviz (large, regenerated on demand)
data/finviz_universe.csv
data/universe/us_closes.csv
data/universe/us_volumes.csv

# When the dashboard last TRIED to auto-refresh the US universe. Host-local
# state -- committing it would hand every checkout someone else's "already
# fetched today" and suppress the first fetch on a fresh clone.
data/universe/us_last_fetch.txt

# Fundamentals snapshots fetched by the analyst. Deliberately untracked: each
# file is a picture of ONE day's ratios with no history in it, so a committed
# copy would age into a set of numbers that look current and are not.
data/fundamentals/

# API keys for the LLM analyst. `.env.example` is the tracked template.
.env
