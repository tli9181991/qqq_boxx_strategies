# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# Charts and CSVs written by run_backtest.py (--outdir, default 'output')
output/

# OS noise
.DS_Store

# NOTE: data/*.csv is deliberately TRACKED -- the cached price history is what
# makes `run_backtest.py --offline` work without a data feed.

# Live runner state and the SQLite run log (host-local, never committed)
var/
*.db
*.db-wal
*.db-shm

# Docker deployment secrets (IB login, VNC password)
deploy/docker/.env

# Hourly OHLCV cache (one CSV per name, large)
data/hourly/

# Per-ticker daily OHLC cache for the dashboard candlesticks
data/ohlc/

# Broad US universe pulled from Finviz (large, regenerated on demand)
data/finviz_universe.csv
data/universe/us_closes.csv
data/universe/us_volumes.csv

# Patreon pipeline credentials. The OAuth client secret and the saved Drive
# token both live under var/ (already ignored above), but these patterns cover
# them wherever someone puts them -- a leaked drive_token.json is a live
# credential, not a config file.
client_secret*.json
drive_token.json
cookies.txt
deploy/patreon/patreon.env
deploy/patreon/config.json
