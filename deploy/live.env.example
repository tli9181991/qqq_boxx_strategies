# Installed to /etc/qbs/live.env and read by every unit.
# Anything set here overrides the JSON file.

QBS_LIVE_CONFIG=/etc/qbs/live.json
QBS_STATE_DIR=/opt/qbs/var
PYTHONUNBUFFERED=1

# Uncomment for the first few sessions to compute and log orders without
# sending any. Remove it once you are happy with the order lists.
#QBS_DRY_RUN=1

# Paper account number, if the Gateway serves more than one.
#QBS_IB_ACCOUNT=DU1234567

# Book size. Overrides "notional" in the JSON.
#QBS_NOTIONAL=100000
