# ===== LINUX / systemd =====  installed to /etc/patreon/patreon.env
# On Windows, edit deploy\windows\patreon.env instead -- this file is not read.
# Copy to /etc/patreon/patreon.env, chmod 600, chown to the service user.
# systemd reads this via EnvironmentFile. Never commit the real file.

PATREON_CONFIG=/etc/patreon/config.json
PATREON_STATE_DIR=/var/lib/patreon

# Gmail app password (Google Account -> Security -> 2-Step Verification ->
# App passwords). NOT your account password. This is the only secret the
# pipeline reads from the environment, and the only one it will accept.
PATREON_IMAP_USER=you@gmail.com
PATREON_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# Any patron-only post, used by the daily session health check. When this stops
# resolving, your Patreon login has expired.
PATREON_PROBE_URL=https://www.patreon.com/posts/12345678

# The browser profile yt-dlp reads cookies from. Firefox is the reliable
# choice: Chrome's cookie store is encrypted against the desktop keyring on
# Linux and locked while the browser is running.
PATREON_COOKIES_FROM_BROWSER=firefox

# --- transcription ----------------------------------------------------------
# Whisper runs on the downloaded media and uploads a .txt and .srt alongside
# the video. Override the config file's values here when you want to try a
# different model without editing tracked settings.
#
# PATREON_WHISPER_MODEL=large-v3-turbo   # "small" if turbo is too slow
# PATREON_WHISPER_DEVICE=cpu             # "cuda" if the box has a usable GPU
# PATREON_WHISPER_COMPUTE_TYPE=int8      # "float16" on CUDA
# PATREON_TRANSCRIBE=true
# PATREON_UPLOAD_MEDIA=true              # false -> transcript-only archive
