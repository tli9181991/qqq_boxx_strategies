[Unit]
Description=QBS post-close reconcile (Docker)
Documentation=file:/opt/qbs/deploy/docker/README.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/qbs

# --rm so a failed run leaves no stopped container behind. The phase name is
# the whole command because the image's ENTRYPOINT is the runner.
ExecStart=/usr/bin/docker compose -f /opt/qbs/deploy/docker/docker-compose.yml run --rm --no-deps qbs reconcile

TimeoutStartSec=300
Restart=on-failure
RestartSec=60
StartLimitBurst=2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qbs-reconcile

[Install]
WantedBy=multi-user.target
