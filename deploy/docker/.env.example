# Copy to deploy/docker/.env and fill in. That file is gitignored.
#   cp deploy/docker/.env.example deploy/docker/.env && chmod 600 deploy/docker/.env

# --- IB paper account (used by the Gateway container only) ----------------
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password
VNC_PASSWORD=pick_something_long

# Port the Gateway serves the paper API on INSIDE its container. This image
# uses 4004; a host-installed Gateway uses 4002. Check yours with:
#   docker exec ib-gateway cat /proc/net/tcp | grep -i ' 0A '
# column 2 is IP:PORT in hex -- 0FA2 = 4002, 0FA4 = 4004.
IBG_PAPER_PORT=4004

# --- the trader -----------------------------------------------------------
# Must match your host user, so files in var/ and data/ are not root-owned.
# Get them with:  id -u   and   id -g
QBS_UID=1000
QBS_GID=1000

# Book size in dollars. Fixed, not the account's net liquidation value.
QBS_NOTIONAL=100000

# Your paper account number, if the Gateway serves more than one. Blank is fine.
QBS_IB_ACCOUNT=

# 1 = compute and log orders but send nothing. Set to 0 only when you are
# happy with the order lists the dry runs have been producing.
QBS_DRY_RUN=1
