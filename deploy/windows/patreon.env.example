# ===== WINDOWS =====  read by deploy\windows\run.ps1
# Copy to patreon.env IN THIS FOLDER (deploy\windows), not deploy\patreon.
# Copy to patreon.env in this same folder and edit.
# patreon.env is gitignored. It holds a live credential -- keep it in your user
# profile's copy of the repo, not a shared or synced folder.

PATREON_CONFIG=C:\ProgramData\PatreonPipeline\config.json
PATREON_STATE_DIR=C:\ProgramData\PatreonPipeline

# Gmail app password (Google Account -> Security -> 2-Step Verification ->
# App passwords). NOT your account password. Paste it with no quotes and no
# spaces -- Google displays it in four blocks of four, but it is entered as
# sixteen characters.
PATREON_IMAP_USER=you@gmail.com
PATREON_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# Any patron-only post, used by the daily session health check.
PATREON_PROBE_URL=https://www.patreon.com/posts/12345678

# Firefox, not Chrome. Chrome and Edge encrypt their cookie store with Windows
# DPAPI against the logged-in user, and reading it is both fragile and blocked
# while the browser is running. Firefox keeps cookies.sqlite in the clear, so
# yt-dlp reads it whether or not Firefox is open.
PATREON_COOKIES_FROM_BROWSER=firefox

# Windows caps paths at 260 characters unless long-path support is enabled, so
# filenames are trimmed harder here than on Linux. Raise it if you have turned
# on Win32 long paths (see the Windows setup doc).
# PATREON_TITLE_BYTES=100

# --- uploads ----------------------------------------------------------------
# rclone owns its own Google credentials -- run `rclone config` once and give
# the remote this name. Nothing else to set up: no Cloud project, no consent
# screen, no token that expires.
PATREON_UPLOADER=rclone
PATREON_RCLONE_REMOTE=gdrive
PATREON_RCLONE_BASE_PATH=Patreon

# --- transcription ----------------------------------------------------------
# PATREON_WHISPER_MODEL=large-v3-turbo   # "small" if turbo is too slow
# PATREON_WHISPER_DEVICE=cpu             # "cuda" if the box has a usable GPU
# PATREON_WHISPER_COMPUTE_TYPE=int8      # "float16" on CUDA
# PATREON_UPLOAD_MEDIA=true              # false -> transcript-only archive
